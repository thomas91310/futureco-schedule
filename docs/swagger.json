{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Trainer scheduling API. Schedule routes use the /api/v1 prefix below. GET /api/health checks the database and is not versioned, because the later e2e warm-up calls that path.",
        "title": "futureco-schedule",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/health": {
            "get": {
                "description": "Runs SELECT 1. Mounted at GET /api/health, outside /api/v1, so the e2e warm-up path stays stable.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Database health",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.HealthResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorUnavailable"
                        }
                    }
                }
            }
        },
        "/api/v1/appointments": {
            "post": {
                "description": "Books one half-hour slot during Monday through Friday, 8:00am to 5:00pm Pacific. The trainer and user must exist, and the trainer must be free at starts_at.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "appointments"
                ],
                "summary": "Create an appointment",
                "parameters": [
                    {
                        "description": "Appointment",
                        "name": "appointment",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/httpapi.CreateAppointmentRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/httpapi.AppointmentResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorBadRequest"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorNotFound"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorConflict"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorInternal"
                        }
                    }
                }
            }
        },
        "/api/v1/trainers/{trainer_id}/appointments": {
            "get": {
                "description": "Returns a trainer's appointments ordered by start time. Use cursor from next_cursor to read the next page.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "appointments"
                ],
                "summary": "List scheduled appointments",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Trainer ID",
                        "name": "trainer_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Page size, default 50, maximum 100",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Opaque cursor from the previous page",
                        "name": "cursor",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.AppointmentListResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorBadRequest"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorNotFound"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorInternal"
                        }
                    }
                }
            }
        },
        "/api/v1/trainers/{trainer_id}/available-times": {
            "get": {
                "description": "Returns unbooked 30-minute slots that start on a half-hour, start at or after starts_at, end at or before ends_at, and fall on Monday through Friday between 8:00am and 5:00pm Pacific. The window must be 31 days or less.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "appointments"
                ],
                "summary": "List available times",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Trainer ID",
                        "name": "trainer_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Window start (RFC3339)",
                        "name": "starts_at",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Window end (RFC3339)",
                        "name": "ends_at",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.AvailableTimesResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorBadRequest"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorNotFound"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorInternal"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "httpapi.AppointmentListResponse": {
            "type": "object",
            "properties": {
                "has_more": {
                    "type": "boolean",
                    "example": false
                },
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/schedule.Appointment"
                    }
                },
                "next_cursor": {
                    "type": "string"
                },
                "status_code": {
                    "type": "integer",
                    "example": 200
                }
            }
        },
        "httpapi.AppointmentResponse": {
            "type": "object",
            "properties": {
                "ends_at": {
                    "type": "string",
                    "example": "2026-01-15T10:30:00Z"
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "starts_at": {
                    "type": "string",
                    "example": "2026-01-15T10:00:00Z"
                },
                "status_code": {
                    "type": "integer",
                    "example": 201
                },
                "trainer_id": {
                    "type": "integer",
                    "example": 1
                },
                "user_id": {
                    "type": "integer",
                    "example": 2
                }
            }
        },
        "httpapi.AvailableTimesResponse": {
            "type": "object",
            "properties": {
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/schedule.Slot"
                    }
                },
                "status_code": {
                    "type": "integer",
                    "example": 200
                }
            }
        },
        "httpapi.CreateAppointmentRequest": {
            "type": "object",
            "properties": {
                "ends_at": {
                    "type": "string",
                    "example": "2026-01-15T10:30:00Z"
                },
                "starts_at": {
                    "type": "string",
                    "example": "2026-01-15T10:00:00Z"
                },
                "trainer_id": {
                    "type": "integer",
                    "example": 1
                },
                "user_id": {
                    "type": "integer",
                    "example": 2
                }
            }
        },
        "httpapi.ErrorBadRequest": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "ends_at must be after starts_at"
                },
                "status_code": {
                    "type": "integer",
                    "example": 400
                }
            }
        },
        "httpapi.ErrorConflict": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "slot already booked"
                },
                "status_code": {
                    "type": "integer",
                    "example": 409
                }
            }
        },
        "httpapi.ErrorInternal": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "internal error"
                },
                "status_code": {
                    "type": "integer",
                    "example": 500
                }
            }
        },
        "httpapi.ErrorNotFound": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "trainer not found"
                },
                "status_code": {
                    "type": "integer",
                    "example": 404
                }
            }
        },
        "httpapi.ErrorUnavailable": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "database unavailable"
                },
                "status_code": {
                    "type": "integer",
                    "example": 503
                }
            }
        },
        "httpapi.HealthResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ok"
                },
                "status_code": {
                    "type": "integer",
                    "example": 200
                }
            }
        },
        "schedule.Appointment": {
            "type": "object",
            "properties": {
                "ends_at": {
                    "type": "string",
                    "example": "2026-01-15T10:30:00Z"
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "starts_at": {
                    "type": "string",
                    "example": "2026-01-15T10:00:00Z"
                },
                "trainer_id": {
                    "type": "integer",
                    "example": 1
                },
                "user_id": {
                    "type": "integer",
                    "example": 2
                }
            }
        },
        "schedule.Slot": {
            "type": "object",
            "properties": {
                "ends_at": {
                    "type": "string",
                    "example": "2026-01-15T10:30:00Z"
                },
                "starts_at": {
                    "type": "string",
                    "example": "2026-01-15T10:00:00Z"
                }
            }
        }
    }
}